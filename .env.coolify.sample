# Copy these entries into the ignored .env; DB_URL is managed by Coolify.
COOLIFY_BASE_URL=https://coolify.fastsme.com
COOLIFY_API_TOKEN=
XAI_API_KEY=
OPENAI_API_KEY=
JUDGE_LLM=gpt-5.1
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-5.1
EVAL_PROBABILISTIC_THRESHOLD=0.85
EVAL_DETERMINISTIC_THRESHOLD=1.0
EVAL_WORKERS=4
EVAL_TIMEOUT_SECONDS=120
