# FastLMS environment variables
# Copy to .env and fill in values

# PostgreSQL database URL (required)
DB_URL=postgresql://user:password@localhost:5432/your_database
DB_SCHEMA=fastlms

# Environment: set explicitly. Weak SESSION_SECRET is allowed only for
# APP_ENV=dev|development|local|test. Use production/staging for deploy.
APP_ENV=dev

# Session signing secret. Required (and must not be a weak default) when
# APP_ENV is not an explicit dev/test value. Generate a long random string
# for production — never ship the old fastlms-dev-secret-change-me default.
SESSION_SECRET=

# LLM provider for AI Tutor chat (xai | openai | anthropic)
MODEL_PROVIDER=xai
DEFAULT_MODEL=grok-4-1-fast-reasoning

# API keys (only the one matching MODEL_PROVIDER is needed)
XAI_API_KEY=
OPENAI_API_KEY=
# Dedicated model for offline student-learning evaluation. Keep this independent
# from the live tutor model so cost, capability and rollout can be changed safely.
JUDGE_LLM=gpt-5.1
STUDENT_EVAL_API_BASE_URL=https://fastlearn.fun/api/v1
EVAL_OUTPUT_DIR=artifacts/evals
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lms.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://lms.fastsme.com
FASTLEARN_PUBLIC_URL=https://fastlearn.fun
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
